# 复制本文件为 .env 并填入真实值

# ===== 当前使用的 LLM 供应商 =====
# 可选预设:deepseek / openai / moonshot / qwen / zhipu / kimi / custom
# (预设表在 harness/providers.py,加一家 = 加一行)
LLM_PROVIDER=deepseek

# 切换供应商/模型时按需设置:
# LLM_MODEL=               # 指定模型;deepseek 默认 deepseek-v4-pro,kimi 默认
#                           # kimi-for-coding-highspeed,其他供应商必填
# LLM_BASE_URL=            # 自定义接入点(LLM_PROVIDER=custom 时必填,如本地 vLLM/Ollama)
# LLM_API_KEY=             # 通用 key 覆盖;默认读下方各家自己的 *_API_KEY

# ===== 各家 API Key(用哪家填哪家)=====
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_API_KEY=
# MOONSHOT_API_KEY=
# DASHSCOPE_API_KEY=
# ZHIPU_API_KEY=
# KIMI_API_KEY=

# ===== 通用选项(均有默认值)=====
# MAX_STEPS=30             # 单次运行最大 LLM 调用轮数
# TOOL_TIMEOUT_S=60        # 单个工具执行超时(秒)
# LLM_TIMEOUT_S=120        # 单次 LLM 请求超时(秒)
# LLM_RETRIES=3            # LLM 请求重试次数
# LLM_MAX_TOKENS=          # 限制单次回复 token 数(默认不限制)
# TEMPERATURE=             # 采样温度(默认用 API 方默认值)
# HOST=127.0.0.1
# PORT=8642
# SYSTEM_PROMPT=           # 覆盖默认系统提示词
PAPER_EXTRACTION_MODEL=claude-opus-5
# Required by the per-paper experimental-design extractor.
ANTHROPIC_API_KEY=
# KNOWLEDGE_DISTILLATION_MODEL=claude-opus-5
# Reuses ANTHROPIC_API_KEY above; used by Step05 (basic knowledge
# extraction) of the Biological Knowledge Distillation module.
