{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "biological-knowledge-distillation/framework/unified-schema.json",
  "title": "Biological Knowledge Distillation - Unified Knowledge Object Schema",
  "description": "Common layer shared by every knowledge asset produced by this module (concepts, mechanisms, engineering principles, decision rules, design patterns, validation strategies, failure patterns) so that this module and 论文实验设计抽取 (paper_experimental_design_extraction) can be linked through one vocabulary instead of two incompatible schemas.",
  "$defs": {
    "knowledgeStatus": {
      "type": "string",
      "enum": ["candidate", "validated", "human_approved", "active", "deprecated", "superseded"],
      "description": "Knowledge lifecycle. New objects start at candidate. Only human_approved/active objects should feed automatic engineering suggestions."
    },
    "derivationType": {
      "type": "string",
      "enum": ["explicit_in_source", "normalized_from_source", "cross_source_synthesis", "model_inference"],
      "description": "How far the object is from the source's literal words. Must never be upgraded silently."
    },
    "knowledgeStatement": {
      "type": "object",
      "description": "Layered statement so source wording, normalized fact, and model synthesis are never blurred together.",
      "properties": {
        "source_statement": {"type": ["string", "null"]},
        "normalized_fact": {"type": ["string", "null"]},
        "derived_principle": {"type": ["string", "null"]},
        "model_synthesis": {"type": ["string", "null"]},
        "agent_recommendation": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "bilingualText": {
      "type": "object",
      "properties": {
        "name_zh": {"type": "string"},
        "name_en": {"type": "string"},
        "definition_zh": {"type": "string"},
        "definition_en": {"type": "string"},
        "source_language": {"type": "string", "enum": ["zh", "en", "other", "unknown"]},
        "original_text": {"type": "string"},
        "translated_text": {"type": "string"},
        "translation_status": {"type": "string", "enum": ["not_translated", "machine_translated", "human_reviewed", "source_is_bilingual"]},
        "translation_confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "confidenceBreakdown": {
      "type": "object",
      "description": "Confidence must be explainable, not a bare number. See SKILL.md '置信度计算规则'.",
      "properties": {
        "value": {"type": "number", "minimum": 0, "maximum": 1},
        "band": {"type": "string", "enum": ["high", "medium", "low"]},
        "source_authority": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_directness": {"type": "number", "minimum": 0, "maximum": 1},
        "cross_source_agreement": {"type": "number", "minimum": 0, "maximum": 1},
        "expert_review_bonus": {"type": "number", "minimum": 0, "maximum": 1},
        "conflict_penalty": {"type": "number", "minimum": 0, "maximum": 1},
        "inference_distance_penalty": {"type": "number", "minimum": 0, "maximum": 1},
        "rationale": {"type": "string"}
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "organism_scope": {"type": "array", "items": {"type": "string"}},
        "strain_scope": {"type": "array", "items": {"type": "string"}},
        "condition_scope": {"type": "array", "items": {"type": "string"}},
        "biological_scale": {"type": "string", "enum": ["molecular", "pathway", "cellular", "population", "process", "unknown"]},
        "pedagogical_simplification": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    },
    "evidenceRef": {
      "type": "object",
      "required": ["evidence_id", "source_id", "evidence_role", "support_level"],
      "properties": {
        "evidence_id": {"type": "string"},
        "source_id": {"type": "string"},
        "source_type": {"type": "string"},
        "source_language": {"type": "string"},
        "original_text": {"type": "string"},
        "translated_text": {"type": "string"},
        "chapter": {"type": "string"},
        "section": {"type": "string"},
        "page": {"type": "string"},
        "figure": {"type": "string"},
        "table": {"type": "string"},
        "equation": {"type": "string"},
        "source_anchor": {"type": "object"},
        "supports_field": {"type": "string"},
        "evidence_role": {"type": "string", "enum": ["definition", "mechanism", "condition", "exception", "recommendation", "limitation", "example"]},
        "subject_attribution": {"type": "string"},
        "support_level": {"type": "string", "enum": ["direct", "partial", "contextual", "conflicting"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "knowledgeObjectBase": {
      "type": "object",
      "description": "Fields every knowledge asset inherits, regardless of subtype. Mirrors ExperimentalCase's provenance discipline in 论文实验设计抽取 so the two asset families stay linkable.",
      "required": ["id", "type", "name_zh", "name_en", "evidence", "confidence", "knowledge_status", "derivation_type", "requires_human_review"],
      "properties": {
        "id": {"type": "string"},
        "type": {
          "type": "string",
          "enum": ["concept", "mechanism", "biological_rule", "engineering_principle", "decision_rule", "design_pattern", "validation_strategy", "failure_pattern", "constraint", "tradeoff", "experimental_method_principle", "measurement_principle"]
        },
        "name_zh": {"type": "string"},
        "name_en": {"type": "string"},
        "aliases_zh": {"type": "array", "items": {"type": "string"}},
        "aliases_en": {"type": "array", "items": {"type": "string"}},
        "statement": {"$ref": "#/$defs/knowledgeStatement"},
        "scope": {"$ref": "#/$defs/scope"},
        "dbtl_stage": {"type": "array", "items": {"type": "string", "enum": ["design", "build", "test", "learn", "not_applicable"]}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}},
        "confidence": {"$ref": "#/$defs/confidenceBreakdown"},
        "knowledge_status": {"$ref": "#/$defs/knowledgeStatus"},
        "derivation_type": {"$ref": "#/$defs/derivationType"},
        "relationships": {"type": "array", "items": {"type": "object"}},
        "provenance": {"type": "object"},
        "requires_human_review": {"type": "boolean"},
        "review_status": {"type": "string", "enum": ["not_reviewed", "pending", "approved", "rejected", "changes_requested"]}
      }
    }
  }
}
