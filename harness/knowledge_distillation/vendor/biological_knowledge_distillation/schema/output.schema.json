{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Biological Knowledge Distillation - Output",
  "type": "object",
  "required": [
    "task_id", "status", "summary", "task_contract", "validated_sources", "source_structure",
    "extraction_scope", "biological_concepts", "biological_mechanisms", "engineering_principles",
    "decision_rules", "decision_trees", "design_patterns", "validation_strategies", "failure_patterns",
    "constraints_and_tradeoffs", "canonical_knowledge_objects", "cross_source_fusions", "source_conflicts",
    "paper_case_links", "knowledge_graph", "quality_report", "governance", "frontend_view",
    "artifacts", "step_states", "step_logs", "errors"
  ],
  "properties": {
    "task_id": {"type": "string"},
    "status": {"enum": ["CREATED", "RUNNING", "WAITING_REVIEW", "COMPLETED", "FAILED"]},
    "summary": {"type": "object"},
    "task_contract": {"type": "object"},
    "validated_sources": {"type": "array"},
    "source_structure": {"type": "object"},
    "extraction_scope": {"type": "array"},
    "biological_concepts": {"type": "array"},
    "biological_mechanisms": {"type": "array"},
    "engineering_principles": {"type": "array"},
    "decision_rules": {"type": "array"},
    "decision_trees": {"type": "array"},
    "design_patterns": {"type": "array"},
    "validation_strategies": {"type": "array"},
    "failure_patterns": {"type": "array"},
    "constraints_and_tradeoffs": {"type": "array"},
    "canonical_knowledge_objects": {"type": "array"},
    "cross_source_fusions": {"type": "array"},
    "source_conflicts": {"type": "array"},
    "paper_case_links": {"type": "array"},
    "knowledge_graph": {"type": "object"},
    "quality_report": {"type": "object"},
    "governance": {"type": "object"},
    "frontend_view": {"type": "object"},
    "artifacts": {"type": "array"},
    "step_states": {"type": "object"},
    "step_logs": {"type": "array"},
    "errors": {"type": "array"},
    "start_time": {"type": ["string", "null"]},
    "end_time": {"type": ["string", "null"]}
  }
}
