{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Biological Knowledge Distillation - Knowledge object subtypes",
  "description": "Documentation/validation schema for the objects held in output.engineering_principles / decision_rules / design_patterns / validation_strategies / failure_patterns / canonical_knowledge_objects. Every subtype below is expected to also satisfy framework/unified-schema.json#/$defs/knowledgeObjectBase.",
  "$defs": {
    "engineeringPrinciple": {
      "type": "object",
      "required": ["principle_id", "trigger_conditions", "required_preconditions", "recommended_actions", "contraindications", "evidence", "derivation_type", "confidence"],
      "properties": {
        "principle_id": {"type": "string"},
        "name_zh": {"type": "string"},
        "name_en": {"type": "string"},
        "principle_statement_zh": {"type": "string"},
        "principle_statement_en": {"type": "string"},
        "biological_basis": {"type": "array", "items": {"type": "string"}},
        "engineering_objective": {"type": "array", "items": {"type": "string"}},
        "trigger_conditions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "required_preconditions": {"type": "array", "items": {"type": "string"}},
        "recommended_actions": {"type": "array", "items": {"type": "string"}},
        "expected_effects": {"type": "array", "items": {"type": "string"}},
        "possible_side_effects": {"type": "array", "items": {"type": "string"}},
        "failure_conditions": {"type": "array", "items": {"type": "string"}},
        "contraindications": {"type": "array", "items": {"type": "string"}},
        "do_not_generalize_to": {"type": "array", "items": {"type": "string"}},
        "alternatives": {"type": "array", "items": {"type": "string"}},
        "validation_requirements": {"type": "array", "items": {"type": "string"}},
        "dbtl_stage": {"type": "array", "items": {"type": "string"}},
        "organism_scope": {"type": "array", "items": {"type": "string"}},
        "strain_scope": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "minItems": 1},
        "derivation_type": {"type": "string", "enum": ["explicit_in_source", "normalized_from_source", "cross_source_synthesis", "model_inference"]},
        "confidence": {},
        "requires_human_review": {"type": "boolean"}
      }
    },
    "decisionRule": {
      "type": "object",
      "required": ["decision_rule_id", "decision_topic", "inputs", "decision_conditions", "branches", "evidence", "derivation_type"],
      "properties": {
        "decision_rule_id": {"type": "string"},
        "decision_topic": {"type": "string"},
        "question_zh": {"type": "string"},
        "question_en": {"type": "string"},
        "inputs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "decision_conditions": {"type": "array", "items": {"type": "string"}},
        "branches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["condition", "recommended_option"],
            "properties": {
              "condition": {"type": "string"},
              "recommended_option": {"type": "string"},
              "reasoning": {"type": "string"}
            }
          }
        },
        "recommended_option": {"type": "array", "items": {"type": "string"}},
        "rejected_options": {"type": "array", "items": {"type": "string"}},
        "reasoning_basis": {"type": "array", "items": {"type": "string"}},
        "required_measurements": {"type": "array", "items": {"type": "string"}},
        "uncertainty": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array"},
        "derivation_type": {"type": "string"},
        "confidence": {},
        "human_review_status": {"type": "string"}
      }
    },
    "designPattern": {
      "type": "object",
      "required": ["pattern_id", "problem_context", "canonical_structure", "applicable_conditions", "non_applicable_conditions"],
      "properties": {
        "pattern_id": {"type": "string"},
        "name_zh": {"type": "string"},
        "name_en": {"type": "string"},
        "problem_context": {"type": "array", "items": {"type": "string"}},
        "design_intent": {"type": "string"},
        "canonical_structure": {"type": "array", "items": {"type": "string"}},
        "biological_rationale": {"type": "array", "items": {"type": "string"}},
        "applicable_conditions": {"type": "array", "items": {"type": "string"}},
        "non_applicable_conditions": {"type": "array", "items": {"type": "string"}},
        "common_variants": {"type": "array", "items": {"type": "string"}},
        "known_tradeoffs": {"type": "array", "items": {"type": "string"}},
        "validation_strategy_ids": {"type": "array", "items": {"type": "string"}},
        "failure_pattern_ids": {"type": "array", "items": {"type": "string"}},
        "supporting_principles": {"type": "array", "items": {"type": "string"}},
        "supporting_sources": {"type": "array", "items": {"type": "string"}},
        "supporting_paper_cases": {"type": "array", "items": {"type": "string"}},
        "maturity": {"type": "string", "enum": ["candidate", "reviewed", "validated"]},
        "confidence": {}
      }
    },
    "validationStrategy": {
      "type": "object",
      "required": ["validation_strategy_id", "target_claim", "minimum_validation", "evidence"],
      "properties": {
        "validation_strategy_id": {"type": "string"},
        "target_claim": {"type": "string"},
        "minimum_validation": {"type": "array", "items": {"type": "string"}},
        "recommended_validation": {"type": "array", "items": {"type": "string"}},
        "orthogonal_validation": {"type": "array", "items": {"type": "string"}},
        "negative_controls": {"type": "array", "items": {"type": "string"}},
        "positive_controls": {"type": "array", "items": {"type": "string"}},
        "time_scale": {"type": "array", "items": {"type": "string"}},
        "readouts": {"type": "array", "items": {"type": "string"}},
        "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
        "failure_interpretation": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array"}
      }
    },
    "failurePattern": {
      "type": "object",
      "required": ["failure_pattern_id", "trigger_conditions", "observed_symptoms", "evidence"],
      "properties": {
        "failure_pattern_id": {"type": "string"},
        "name_zh": {"type": "string"},
        "name_en": {"type": "string"},
        "trigger_conditions": {"type": "array", "items": {"type": "string"}},
        "observed_symptoms": {"type": "array", "items": {"type": "string"}},
        "possible_causes": {"type": "array", "items": {"type": "string"}},
        "diagnostic_measurements": {"type": "array", "items": {"type": "string"}},
        "mitigation_options": {"type": "array", "items": {"type": "string"}},
        "prevention_options": {"type": "array", "items": {"type": "string"}},
        "scope": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array"},
        "confidence": {}
      }
    },
    "canonicalKnowledgeObject": {
      "type": "object",
      "required": ["canonical_knowledge_id", "merged_from", "merge_relation", "provenance"],
      "properties": {
        "canonical_knowledge_id": {"type": "string"},
        "canonical_name_zh": {"type": "string"},
        "canonical_name_en": {"type": "string"},
        "merged_from": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "merge_relation": {"type": "string", "enum": ["same_concept", "broader_narrower", "related_but_distinct", "conflicting", "translation_variant", "version_update", "organism_specific_variant", "condition_specific_variant"]},
        "shared_core": {"type": "array", "items": {"type": "string"}},
        "source_specific_variants": {"type": "array"},
        "organism_specific_variants": {"type": "array"},
        "condition_specific_variants": {"type": "array"},
        "conflicts": {"type": "array", "items": {"type": "string"}},
        "unresolved_questions": {"type": "array", "items": {"type": "string"}},
        "provenance": {"type": "array"},
        "fusion_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "review_status": {"type": "string"}
      }
    },
    "sourceConflict": {
      "type": "object",
      "required": ["conflict_id", "topic", "claims", "resolution_status", "requires_human_review"],
      "properties": {
        "conflict_id": {"type": "string"},
        "topic": {"type": "string"},
        "conflict_type": {"type": "string", "enum": ["definition", "mechanism", "condition_scope", "version_update", "organism_difference", "strain_difference", "condition_difference", "textbook_simplification_vs_primary_research", "translation_ambiguity", "terminology_shift", "genuine_authority_disagreement"]},
        "claims": {"type": "array"},
        "possible_explanation": {"type": "array", "items": {"type": "string"}},
        "impact_on_agent_use": {"type": "string"},
        "resolution_status": {"type": "string", "enum": ["resolved", "partially_resolved", "unresolved"]},
        "requires_human_review": {"type": "boolean"}
      }
    },
    "paperCaseLink": {
      "type": "object",
      "required": ["link_id", "knowledge_object_id", "paper_case_id", "link_type", "evidence"],
      "properties": {
        "link_id": {"type": "string"},
        "knowledge_object_id": {"type": "string"},
        "paper_case_id": {"type": "string"},
        "link_type": {"type": "string", "enum": ["supports", "instantiates", "contradicts", "extends", "limits", "alternative"]},
        "paper_experiment_id": {"type": "string"},
        "shared_entities": {"type": "array", "items": {"type": "string"}},
        "shared_conditions": {"type": "array", "items": {"type": "string"}},
        "differences": {"type": "array", "items": {"type": "string"}},
        "transferability": {"type": "string"},
        "evidence": {"type": "array"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
