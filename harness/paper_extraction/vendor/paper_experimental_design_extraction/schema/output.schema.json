{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["task_id", "status", "summary", "literature_candidates", "validated_papers", "experimental_designs", "evidence_map", "quality_report", "k12_comparison", "engineering_plan", "governance", "frontend_view", "artifacts", "errors"],
  "properties": {
    "task_id": {"type": "string"},
    "status": {"enum": ["CREATED", "RUNNING", "WAITING_REVIEW", "COMPLETED", "FAILED"]},
    "summary": {"type": "object"},
    "literature_candidates": {"type": "array"},
    "validated_papers": {"type": "array"},
    "experimental_designs": {"type": "array"},
    "evidence_map": {"type": "object"},
    "quality_report": {"type": "object"},
    "k12_comparison": {"type": "object"},
    "engineering_plan": {"type": "object"},
    "governance": {"type": "object"},
    "frontend_view": {"type": "object"},
    "artifacts": {"type": "array"},
    "errors": {"type": "array"}
  }
}
