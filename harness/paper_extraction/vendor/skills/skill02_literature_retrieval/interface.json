{
  "skill_id": "skill02_literature_retrieval",
  "version": "0.2.0",
  "implementation": "python",
  "input": {
    "type": "object",
    "required": ["research_intent"],
    "properties": {
      "research_intent": {"$ref": "../../framework/unified-schema.json#/$defs/researchIntent"},
      "retrieval_strategy": {"type": "object"},
      "sources": {"type": "array", "items": {"type": "string"}},
      "limit": {"type": "integer", "minimum": 1},
      "manual_candidates": {"type": "array", "items": {"type": "object"}}
    }
  },
  "output": {
    "type": "object",
    "required": ["candidates", "candidate_annotations", "queries", "source_statuses", "result_state"],
    "properties": {
      "candidates": {"type": "array", "items": {"$ref": "../../framework/unified-schema.json#/$defs/literatureCandidate"}},
      "candidate_annotations": {"type": "object"},
      "queries": {"type": "array", "items": {"type": "object"}},
      "source_statuses": {"type": "object"},
      "result_state": {"enum": ["results", "empty_result"]}
    }
  },
  "status": ["succeeded", "succeeded_with_warnings", "needs_review", "retryable_failure", "terminal_failure", "cancelled"],
  "error_codes": ["EDX-RET-001", "EDX-RET-002", "EDX-RET-003", "EDX-VAL-001", "EDX-VAL-002", "EDX-SYS-001"],
  "local_error_codes": ["RET001", "RET002", "RET003", "RET004", "RET005"],
  "provenance_requirements": ["source", "query_hash", "query_used", "retrieved_at", "source_record_id", "skill_version"],
  "human_review": {"supported": true, "triggers": ["all_sources_failed", "ambiguous_candidate"]}
}
