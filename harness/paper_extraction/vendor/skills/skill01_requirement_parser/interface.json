{
  "skill_id": "skill01_requirement_parser",
  "version": "0.3.0",
  "implementation": "python",
  "input": {"type": "object", "required": ["user_request"], "properties": {"user_request": {"type": "string", "minLength": 1}, "constraints": {"type": "object"}}},
  "output": {
    "type": "object",
    "required": ["research_intent", "field_metadata", "retrieval_strategy"],
    "properties": {
      "research_intent": {"$ref": "../../framework/unified-schema.json#/$defs/researchIntent"},
      "field_metadata": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": ["value", "source", "confidence", "status"],
          "properties": {
            "value": {},
            "source": {"const": "user_input"},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "status": {"enum": ["reported", "unknown", "inferred", "needs_clarification"]}
          }
        }
      },
      "retrieval_strategy": {
        "type": "object",
        "required": ["concept_groups", "queries", "recommended_sources"],
        "properties": {
          "concept_groups": {"type": "object"},
          "queries": {"type": "array", "items": {"type": "object"}},
          "recommended_sources": {"type": "array", "items": {"type": "string"}},
          "search_specification": {"type": "object"}
        }
      }
    }
  },
  "status": ["succeeded", "succeeded_with_warnings", "needs_review", "retryable_failure", "terminal_failure", "cancelled"],
  "error_codes": ["EDX-VAL-001", "EDX-VAL-002", "EDX-VAL-003", "EDX-SYS-001"],
  "provenance_requirements": ["run_id", "step_run_id", "input_hash", "output_hash", "skill_version"],
  "human_review": {"supported": true, "triggers": ["ambiguous_intent", "conflicting_criteria"]}
}
