{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dbtl:paper-experiment-record:0.1.0",
  "title": "PaperExperimentRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "run_id",
    "research_intent",
    "literature_candidate",
    "document",
    "literature_experiment",
    "quality_evaluation",
    "governance",
    "provenance",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "record_id": { "$ref": "#/$defs/uuid" },
    "run_id": { "$ref": "#/$defs/uuid" },
    "research_intent": { "$ref": "#/$defs/researchIntent" },
    "literature_candidate": { "$ref": "#/$defs/literatureCandidate" },
    "document": { "$ref": "#/$defs/document" },
    "literature_experiment": { "$ref": "#/$defs/literatureExperiment" },
    "quality_evaluation": { "$ref": "#/$defs/qualityEvaluation" },
    "k12_transfer_analysis": {
      "oneOf": [{ "$ref": "#/$defs/k12TransferAnalysis" }, { "type": "null" }]
    },
    "ai_engineering_proposal": {
      "oneOf": [{ "$ref": "#/$defs/engineeringProposal" }, { "type": "null" }]
    },
    "governance": { "$ref": "#/$defs/governance" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "created_at": { "$ref": "#/$defs/dateTime" },
    "updated_at": { "$ref": "#/$defs/dateTime" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "nullableString": {
      "type": ["string", "null"]
    },
    "evidenceBoundValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "status",
        "confidence",
        "extraction_method",
        "evidence_ids",
        "notes"
      ],
      "properties": {
        "value": {},
        "status": {
          "enum": ["reported", "unknown", "inferred"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "extraction_method": {
          "enum": [
            "rule",
            "table_parser",
            "document_parser",
            "model",
            "human",
            "hybrid",
            "not_applicable"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "notes": { "$ref": "#/$defs/nullableString" },
        "inference": {
          "type": ["object", "null"],
          "properties": {
            "method": { "type": "string" },
            "rationale": { "type": "string" }
          },
          "required": ["method", "rationale"],
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "reported" } } },
          "then": {
            "properties": {
              "value": { "not": { "type": "null" } },
              "evidence_ids": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "unknown" } } },
          "then": {
            "properties": {
              "value": { "type": "null" },
              "evidence_ids": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "inferred" } } },
          "then": {
            "required": ["inference"],
            "properties": {
              "value": { "not": { "type": "null" } },
              "evidence_ids": { "minItems": 1 },
              "inference": { "type": "object" }
            }
          }
        }
      ]
    },
    "researchIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organism",
        "strain",
        "phenotype",
        "engineering_objective",
        "keywords",
        "inclusion_criteria",
        "exclusion_criteria"
      ],
      "properties": {
        "organism": { "$ref": "#/$defs/nullableString" },
        "strain": { "$ref": "#/$defs/nullableString" },
        "phenotype": { "$ref": "#/$defs/nullableString" },
        "engineering_objective": { "$ref": "#/$defs/nullableString" },
        "keywords": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "inclusion_criteria": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exclusion_criteria": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "literatureCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_id",
        "title",
        "authors",
        "journal",
        "year",
        "identifiers",
        "retrieval_sources",
        "citation_validation"
      ],
      "properties": {
        "paper_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "authors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "journal": { "$ref": "#/$defs/nullableString" },
        "year": {
          "type": ["integer", "null"],
          "minimum": 1600,
          "maximum": 3000
        },
        "identifiers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "retrieval_sources": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "citation_validation": {
          "type": "object",
          "required": ["status", "attempts", "checks"],
          "properties": {
            "status": { "enum": ["valid", "invalid", "conflict", "unknown"] },
            "attempts": { "type": "integer", "minimum": 0, "maximum": 3 },
            "checks": { "type": "array", "items": { "type": "object" } }
          },
          "additionalProperties": false
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "media_type", "sha256", "version", "source"],
      "properties": {
        "artifact_id": { "type": "string" },
        "media_type": { "type": "string" },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "version": { "type": "string" },
        "source": { "type": "string" },
        "uri": { "$ref": "#/$defs/nullableString" }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts", "parse_status", "section_index"],
      "properties": {
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactRef" }
        },
        "parse_status": {
          "enum": ["not_started", "partial", "complete", "failed"]
        },
        "section_index": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["section_id", "title", "level"],
            "properties": {
              "section_id": { "type": "string" },
              "title": { "type": "string" },
              "level": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "experimentFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "hypothesis",
        "strain",
        "genotype",
        "engineering_method",
        "experimental_groups",
        "controls",
        "culture_conditions",
        "medium",
        "dosage",
        "time",
        "replicates",
        "assay",
        "instruments",
        "analysis_methods",
        "outcomes"
      ],
      "properties": {
        "objective": { "$ref": "#/$defs/evidenceBoundValue" },
        "hypothesis": { "$ref": "#/$defs/evidenceBoundValue" },
        "strain": { "$ref": "#/$defs/evidenceBoundValue" },
        "genotype": { "$ref": "#/$defs/evidenceBoundValue" },
        "engineering_method": { "$ref": "#/$defs/evidenceBoundValue" },
        "experimental_groups": { "$ref": "#/$defs/evidenceBoundValue" },
        "controls": { "$ref": "#/$defs/evidenceBoundValue" },
        "culture_conditions": { "$ref": "#/$defs/evidenceBoundValue" },
        "medium": { "$ref": "#/$defs/evidenceBoundValue" },
        "dosage": { "$ref": "#/$defs/evidenceBoundValue" },
        "time": { "$ref": "#/$defs/evidenceBoundValue" },
        "replicates": { "$ref": "#/$defs/evidenceBoundValue" },
        "assay": { "$ref": "#/$defs/evidenceBoundValue" },
        "instruments": { "$ref": "#/$defs/evidenceBoundValue" },
        "analysis_methods": { "$ref": "#/$defs/evidenceBoundValue" },
        "outcomes": { "$ref": "#/$defs/evidenceBoundValue" }
      }
    },
    "evidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "paper_id",
        "artifact_id",
        "artifact_sha256",
        "locator",
        "quote",
        "quote_sha256",
        "extraction"
      ],
      "properties": {
        "evidence_id": { "type": "string" },
        "paper_id": { "type": "string" },
        "artifact_id": { "type": "string" },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "locator": {
          "type": "object",
          "required": ["page", "section_path", "paragraph_id"],
          "properties": {
            "page": { "type": ["integer", "null"], "minimum": 1 },
            "printed_page": { "$ref": "#/$defs/nullableString" },
            "section_path": {
              "type": "array",
              "items": { "type": "string" }
            },
            "paragraph_id": { "$ref": "#/$defs/nullableString" },
            "figure_id": { "$ref": "#/$defs/nullableString" },
            "table_id": { "$ref": "#/$defs/nullableString" },
            "supplement_id": { "$ref": "#/$defs/nullableString" },
            "char_start": { "type": ["integer", "null"], "minimum": 0 },
            "char_end": { "type": ["integer", "null"], "minimum": 0 }
          },
          "additionalProperties": false
        },
        "quote": { "type": "string" },
        "quote_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "extraction": {
          "type": "object",
          "required": ["method", "component", "component_version"],
          "properties": {
            "method": { "type": "string" },
            "component": { "type": "string" },
            "component_version": { "type": "string" },
            "model": { "$ref": "#/$defs/nullableString" },
            "prompt_hash": { "$ref": "#/$defs/nullableString" }
          },
          "additionalProperties": false
        }
      }
    },
    "literatureExperiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "evidence", "conflicts"],
      "properties": {
        "fields": { "$ref": "#/$defs/experimentFields" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRecord" }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field_path", "candidate_evidence_ids", "status"],
            "properties": {
              "field_path": { "type": "string" },
              "candidate_evidence_ids": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 2
              },
              "status": { "enum": ["open", "resolved", "accepted_ambiguity"] }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "qualityEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completeness",
        "reproducibility",
        "evidence_level",
        "missing_information",
        "extraction_confidence"
      ],
      "properties": {
        "completeness": { "type": "number", "minimum": 0, "maximum": 1 },
        "reproducibility": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_level": { "type": "number", "minimum": 0, "maximum": 1 },
        "missing_information": {
          "type": "array",
          "items": { "type": "string" }
        },
        "extraction_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "k12TransferAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_context",
        "strain_difference",
        "engineering_strategy",
        "advantages",
        "limitations",
        "transferability_risk"
      ],
      "properties": {
        "target_context": { "type": "string" },
        "strain_difference": { "$ref": "#/$defs/evidenceBoundValue" },
        "engineering_strategy": { "$ref": "#/$defs/evidenceBoundValue" },
        "advantages": { "$ref": "#/$defs/evidenceBoundValue" },
        "limitations": { "$ref": "#/$defs/evidenceBoundValue" },
        "transferability_risk": { "$ref": "#/$defs/evidenceBoundValue" }
      }
    },
    "engineeringProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_label", "objective", "steps", "assumptions", "risks", "alternatives"],
      "properties": {
        "proposal_label": { "const": "ai_engineering_proposal" },
        "objective": { "type": "string" },
        "steps": { "type": "array", "items": { "type": "object" } },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "risks": { "type": "array", "items": { "type": "string" } },
        "alternatives": { "type": "array", "items": { "type": "string" } }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["machine_status", "review_status", "publication_status", "review_task_ids"],
      "properties": {
        "machine_status": { "enum": ["pending", "passed", "warning", "failed"] },
        "review_status": {
          "enum": ["not_required", "pending", "in_review", "approved", "changes_requested", "rejected"]
        },
        "publication_status": { "enum": ["draft", "blocked", "publishable", "published"] },
        "review_task_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipeline_version", "skill_runs", "source_artifact_ids"],
      "properties": {
        "pipeline_version": { "type": "string" },
        "skill_runs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["skill_id", "skill_version", "step_run_id", "input_hash", "output_hash"],
            "properties": {
              "skill_id": { "type": "string" },
              "skill_version": { "type": "string" },
              "step_run_id": { "$ref": "#/$defs/uuid" },
              "input_hash": { "type": "string" },
              "output_hash": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "source_artifact_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    }
  }
}
