# 复制本文件为 .env 并填入真实值

# ===== 当前使用的 LLM 供应商 =====
# 可选预设:deepseek / openai / moonshot / qwen / zhipu / poe / custom
# (预设表在 harness/providers.py,加一家 = 加一行)
LLM_PROVIDER=deepseek

# 切换供应商/模型时按需设置:
# LLM_MODEL=               # 指定模型;deepseek 默认 deepseek-v4-pro,poe 没有默认模型
#                           # (Poe 网关下挂多家模型,如 Kimi-K3/Claude/GPT,必须显式指定),
#                           # 其他供应商同样必填
# LLM_BASE_URL=            # 自定义接入点(LLM_PROVIDER=custom 时必填,如本地 vLLM/Ollama)
# LLM_API_KEY=             # 通用 key 覆盖;默认读下方各家自己的 *_API_KEY

# ===== 各家 API Key(用哪家填哪家)=====
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_API_KEY=
# MOONSHOT_API_KEY=
# DASHSCOPE_API_KEY=
# ZHIPU_API_KEY=
# POE_API_KEY=             # LLM_PROVIDER=poe 时读取(直连 api.poe.com,和下面 Skill07/
#                           # Step05 走本地 Poe-Code-CLI 用的是同一把 key,但这里是走 HTTP
#                           # 直连,需要单独在这个 .env 里配置一份,不会读 poe-api.env)
# KIMI_API_KEY=             # 仅供 skill02_literature_retrieval 的 KimiK3Client 使用
#                           # (查询扩写 + 相关性打分,直连 api.kimi.com/coding/v1)

# ===== 通用选项(均有默认值)=====
# MAX_STEPS=30             # 单次运行最大 LLM 调用轮数
# TOOL_TIMEOUT_S=60        # 单个工具执行超时(秒)
# LLM_TIMEOUT_S=120        # 单次 LLM 请求超时(秒)
# LLM_RETRIES=3            # LLM 请求重试次数
# LLM_MAX_TOKENS=          # 限制单次回复 token 数(默认不限制)
# TEMPERATURE=             # 采样温度(默认用 API 方默认值)
# HOST=127.0.0.1
# PORT=8642
# SYSTEM_PROMPT=           # 覆盖默认系统提示词
PAPER_EXTRACTION_MODEL=claude-sonnet-4.6
# Skill07 runs through a local Poe-Code-CLI installation instead of an HTTP
# model endpoint. The launcher reads POE_API_KEY from its own ignored
# poe-api.env file; never commit that file.
POE_CODE_CLI_DIR=.poe-code-cli
# POE_CODE_NODE=node
PAPER_EXTRACTION_SKILL07_TIMEOUT_S=3600
PAPER_EXTRACTION_SKILL07_MAX_ATTEMPTS=5
PAPER_EXTRACTION_SKILL07_RETRY_DELAY_S=30
PAPER_EXTRACTION_MAX_PARALLEL_ITEMS=8
PAPER_EXTRACTION_TASK_WORKERS=4
PAPER_EXTRACTION_MAX_CONCURRENT_MODEL_CALLS=6
# KNOWLEDGE_DISTILLATION_MODEL=claude-sonnet-4.6
# Step05 (basic knowledge extraction) of the Biological Knowledge
# Distillation module also runs through the local Poe-Code-CLI installation
# above (same POE_API_KEY / POE_CODE_CLI_DIR / POE_CODE_NODE settings).
# KNOWLEDGE_DISTILLATION_SKILL05_TIMEOUT_S=300
