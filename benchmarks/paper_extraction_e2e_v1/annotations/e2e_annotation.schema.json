{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper_extraction_e2e_annotation_v1",
  "type": "object",
  "required": ["benchmark_version", "annotation_tier", "annotation_source", "annotator_status", "review_status", "adjudication_status", "papers"],
  "properties": {
    "benchmark_version": {"const": "paper_extraction_e2e_v1"},
    "annotation_tier": {"enum": ["gold", "silver"]},
    "annotation_source": {"type": "string", "minLength": 1},
    "annotator_status": {"type": "string", "minLength": 1},
    "review_status": {"type": "string", "minLength": 1},
    "adjudication_status": {"type": "string", "minLength": 1},
    "papers": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}
